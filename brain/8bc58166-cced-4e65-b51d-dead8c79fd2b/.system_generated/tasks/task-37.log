        desc.innerText = "Puncak kemewahan! Liburan romantis dan pemandangan laut Aegea biru menyambut pahlawan kita. Anda hampir sampai!";
        imgCont.style.backgroundImage = "url('https://images.unsplash.com/photo-1613395877344-13d4a8e0d49e?auto=format&fit=crop&w=600&q=80')";
    }
    
    modal.classList.add("active");
}

function closeFomoModal() {
    document.getElementById("fomo-modal").classList.remove("active");
}
